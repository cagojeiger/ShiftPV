{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "port", "snapshotInterval", "dashboard", "prometheusRule", "serviceMonitor"],
      "properties": {
        "dashboard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "labels"],
          "properties": {
            "enabled": {"type": "boolean"},
            "labels": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        },
        "enabled": {"type": "boolean"},
        "port": {"type": "integer", "minimum": 1024, "maximum": 65535, "not": {"enum": [9808]}},
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "additionalLabels"],
          "properties": {
            "enabled": {"type": "boolean"},
            "additionalLabels": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        },
        "snapshotInterval": {"type": "string", "pattern": "^[1-9][0-9]*(s|m)$"},
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "interval", "scrapeTimeout", "additionalLabels"],
          "properties": {
            "enabled": {"type": "boolean"},
            "interval": {"type": "string", "pattern": "^[1-9][0-9]*s$"},
            "scrapeTimeout": {"type": "string", "pattern": "^[1-9][0-9]*s$"},
            "additionalLabels": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        }
      }
    },
    "controller": {
      "type": "object",
      "required": ["replicas", "image"],
      "properties": {
        "replicas": {"type": "integer", "const": 1},
        "logLevel": {"type": "integer", "minimum": 0},
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "minLength": 1},
            "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
          }
        }
      }
    },
    "mobility": {
      "type": "object",
      "required": ["enabled", "interval", "webhookPort", "helperImage"],
      "properties": {
        "enabled": {"type": "boolean"},
        "interval": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m)$"},
        "webhookPort": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "helperImage": {"type": "string"}
      }
    },
    "node": {
      "type": "object",
      "required": ["kubeletRootDir", "image"],
      "properties": {
        "kubeletRootDir": {
          "type": "string",
          "pattern": "^/",
          "description": "Host kubelet state root shared by every selected Node Plugin node"
        },
        "logLevel": {"type": "integer", "minimum": 0},
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "minLength": 1},
            "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
          }
        }
      }
    },
    "helperPod": {
      "type": "object",
      "required": ["image", "timeout"],
      "properties": {
        "image": {"type": "string"},
        "timeout": {"type": "string", "pattern": "^[1-9][0-9]*(ms|s|m)$"},
        "resources": {
          "type": "object",
          "required": ["requests", "limits"],
          "properties": {
            "requests": {
              "type": "object",
              "required": ["cpu", "memory"],
              "properties": {
                "cpu": {"type": "string", "minLength": 1},
                "memory": {"type": "string", "minLength": 1}
              }
            },
            "limits": {
              "type": "object",
              "required": ["cpu", "memory"],
              "properties": {
                "cpu": {"type": "string", "minLength": 1},
                "memory": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "poolReadiness": {
      "type": "object",
      "required": ["interval", "staleAfter"],
      "properties": {
        "interval": {"type": "string", "pattern": "^[1-9][0-9]*(s|m)$"},
        "staleAfter": {"type": "string", "pattern": "^[1-9][0-9]*(s|m)$"}
      }
    },
    "storageClass": {
      "type": "object",
      "required": ["create", "name", "defaultClass", "reclaimPolicy"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string", "minLength": 1},
        "defaultClass": {"type": "boolean"},
        "reclaimPolicy": {"const": "Retain"}
      }
    }
  }
}
