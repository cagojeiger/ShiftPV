{
  "id": null,
  "uid": "shiftpv-overview",
  "title": "ShiftPV · Storage Overview",
  "description": "Filesystem capacity, logical reservations, mobility and CSI health. Read-only observations; no per-PVC quota, transfer speed or dead-node recovery claims.",
  "tags": [
    "shiftpv",
    "storage",
    "kubernetes"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "regex": "",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "options": []
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(shiftpv_metrics_snapshot_success{shiftpv=\"true\"}, cluster)",
        "query": {
          "query": "label_values(shiftpv_metrics_snapshot_success{shiftpv=\"true\"}, cluster)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(shiftpv_metrics_snapshot_success{shiftpv=\"true\",cluster=~\"${cluster:regex}\"}, namespace)",
        "query": {
          "query": "label_values(shiftpv_metrics_snapshot_success{shiftpv=\"true\",cluster=~\"${cluster:regex}\"}, namespace)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "pool",
        "label": "Pool · capacity panels only",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(shiftpv_pool_ready{shiftpv=\"true\",cluster=~\"${cluster:regex}\",namespace=~\"${namespace:regex}\"}, pool)",
        "query": {
          "query": "label_values(shiftpv_pool_ready{shiftpv=\"true\",cluster=~\"${cluster:regex}\",namespace=~\"${namespace:regex}\"}, pool)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Scrape targets · 1 up / 0 down",
      "description": "ShiftPV targets only. Missing targets are No data, not healthy. Pool selection applies only to Pool panels.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "up{shiftpv=\"true\",cluster=~\"${cluster:regex}\",namespace=~\"${namespace:regex}\"}",
          "legendFormat": "{{pod}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Snapshot age · seconds",
      "description": "Age since last successful observation, including preserved values after failures. Before the first success this panel has No data; check Snapshot result for failure. Compare with configured metadata / Pool probe intervals.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "time() - (shiftpv_metrics_snapshot_last_success_timestamp_seconds{shiftpv=\"true\",cluster=~\"${cluster:regex}\",namespace=~\"${namespace:regex}\"} > 0)",
          "legendFormat": "{{pod}} / {{source}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Snapshot result · 1 success / 0 failure",
      "description": "Result of the last completed observation; use age as well to detect a stalled observer. An unregistered node Pool reports filesystem failure.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "shiftpv_metrics_snapshot_success{shiftpv=\"true\",cluster=~\"${cluster:regex}\",namespace=~\"${namespace:regex}\"}",
          "legendFormat": "{{pod}} / {{source}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Pool readiness & accounting · 1 valid / 0 invalid",
      "description": "Ready includes generation and probe freshness at snapshot time. An accounting failure preserves the previous reserved value. Both require a fresh metadata snapshot.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "shiftpv_pool_ready{shiftpv=\"true\",cluster=~\"${cluster:regex}\",namespace=~\"${namespace:regex}\",pool=~\"${pool:regex}\"}",
          "legendFormat": "{{pool}} / ready",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "shiftpv_pool_accounting_valid{shiftpv=\"true\",cluster=~\"${cluster:regex}\",namespace=~\"${namespace:regex}\",pool=~\"${pool:regex}\"}",
          "legendFormat": "{{pool}} / accounting",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Filesystem space · available / total",
      "description": "The filesystem containing the registered directory, including other writers. Multiple Pools can share a filesystem: do not sum these series. Failed probes preserve the last successful value.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "shiftpv_pool_filesystem_available_bytes{shiftpv=\"true\",cluster=~\"${cluster:regex}\",namespace=~\"${namespace:regex}\",pool=~\"${pool:regex}\"}",
          "legendFormat": "{{pool}} / available",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "shiftpv_pool_filesystem_size_bytes{shiftpv=\"true\",cluster=~\"${cluster:regex}\",namespace=~\"${namespace:regex}\",pool=~\"${pool:regex}\"}",
          "legendFormat": "{{pool}} / total",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Filesystem available · percent",
      "description": "BAvail / filesystem size, not per-PVC usage. Check filesystem snapshot age before interpreting the last value.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "100 * shiftpv_pool_filesystem_available_bytes{shiftpv=\"true\",cluster=~\"${cluster:regex}\",namespace=~\"${namespace:regex}\",pool=~\"${pool:regex}\"} / shiftpv_pool_filesystem_size_bytes{shiftpv=\"true\",cluster=~\"${cluster:regex}\",namespace=~\"${namespace:regex}\",pool=~\"${pool:regex}\"}",
          "legendFormat": "{{pool}} / {{node}}",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Logical reservations · reserved / limit",
      "description": "Owner plus approved incoming reservations. These are requested bytes, not file sizes or a write quota. Admission also checks current filesystem availability.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "shiftpv_pool_reserved_bytes{shiftpv=\"true\",cluster=~\"${cluster:regex}\",namespace=~\"${namespace:regex}\",pool=~\"${pool:regex}\"}",
          "legendFormat": "{{pool}} / reserved",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "shiftpv_pool_capacity_limit_bytes{shiftpv=\"true\",cluster=~\"${cluster:regex}\",namespace=~\"${namespace:regex}\",pool=~\"${pool:regex}\"}",
          "legendFormat": "{{pool}} / limit",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "shiftpv_pool_unregistered_reserved_bytes{shiftpv=\"true\",cluster=~\"${cluster:regex}\",namespace=~\"${namespace:regex}\",pool=~\"${pool:regex}\"}",
          "legendFormat": "{{pool}} / without Volume CR",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Available inodes",
      "description": "Filesystem Ffree from the existing Pool probe. A byte-space surplus does not guarantee enough inodes.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "shiftpv_pool_filesystem_available_inodes{shiftpv=\"true\",cluster=~\"${cluster:regex}\",namespace=~\"${namespace:regex}\",pool=~\"${pool:regex}\"}",
          "legendFormat": "{{pool}} / {{node}}",
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Volumes · current phase",
      "description": "Current Volume CR counts across the selected cluster/namespace. Pool selection does not apply.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (phase) (shiftpv_volumes{shiftpv=\"true\",cluster=~\"${cluster:regex}\",namespace=~\"${namespace:regex}\"})",
          "legendFormat": "{{phase}}",
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Moves · currently linked phase",
      "description": "Moves linked by a current Volume activeMove. This is current state, not completed-move throughput or a history counter. Pool selection does not apply.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (phase) (shiftpv_moves{shiftpv=\"true\",cluster=~\"${cluster:regex}\",namespace=~\"${namespace:regex}\"})",
          "legendFormat": "{{phase}}",
          "range": true
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Deferred mobility · reason",
      "description": "Last completed cordon discovery: reasons movement is deferred. Zero after a fresh discovery means no deferrals. Pool selection does not apply.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (reason) (shiftpv_mobility_deferred_volumes{shiftpv=\"true\",cluster=~\"${cluster:regex}\",namespace=~\"${namespace:regex}\"})",
          "legendFormat": "{{reason}}",
          "range": true
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "CSI completed requests · per second",
      "description": "Four lifecycle RPCs only; retries included. Counter resets are handled by rate. Untouched methods have No data. Pool selection does not apply.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (method, code) (rate(shiftpv_csi_requests_total{shiftpv=\"true\",cluster=~\"${cluster:regex}\",namespace=~\"${namespace:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{method}} / {{code}}",
          "range": true
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "CSI non-OK responses · per second",
